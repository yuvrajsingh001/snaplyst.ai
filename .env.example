# .env.example
# Postgres
DATABASE_URL=postgresql://dev:dev@localhost:5432/vintage_dev

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vintage-temp

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# OpenAI / other AI providers (fill for production later)
OPENAI_API_KEY=your_openai_api_key

# Auth provider (Supabase / Firebase) keys placeholder
SUPABASE_URL=...
SUPABASE_ANON_KEY=...
